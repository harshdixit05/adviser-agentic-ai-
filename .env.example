# Copy to .env.local. Never commit the filled-in file.

# The dev cluster runs on 55432 to stay clear of a system Postgres on 5432.
DATABASE_URL="postgresql+psycopg2://postgres@127.0.0.1:55432/advisor"

# Required to run the agent. Rotate immediately if this key ever appears in a
# chat, a log or a commit: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# Phase 2.
QDRANT_URL="http://localhost:6333"
QDRANT_COLLECTION="intellimindz_content"
