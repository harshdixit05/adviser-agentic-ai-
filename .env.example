# Copy to .env.local. Never commit the filled-in file.

# A standard local Postgres. Add a password as postgres:PASSWORD@ if yours has
# one, and change the port if it is not on 5432.
DATABASE_URL="postgresql+psycopg2://postgres@127.0.0.1:5432/advisor"

# Required to run the agent. Rotate immediately if this key ever appears in a
# chat, a log or a commit: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# Shared secret with the website's server. Required in any deployment: it is
# what lets this service tell the website apart from anyone else, and only a
# caller holding it may identify visitors for rate-limiting purposes.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADVISOR_API_TOKEN=""

# Browser origins allowed to call /api/chat, as a JSON list. An empty list
# means no browser may call it, which is the safe default for a service that
# would otherwise answer anyone's page.
ALLOWED_ORIGINS='["http://localhost:3000"]'

# Phase 2.
QDRANT_URL="http://localhost:6333"
QDRANT_COLLECTION="intellimindz_content"
